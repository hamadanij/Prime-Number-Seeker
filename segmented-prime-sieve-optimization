import math

def find_primes_in_range(low, high):
    """
    Finds all prime numbers between 'low' and 'high' using a Segmented Sieve.
    This architecture uses O(sqrt(high)) memory, making it flawless for big data.
    """
    if low < 2:
        low = 2
    if low > high:
        return []

    # Step 1: Find all base primes up to the square root of the maximum limit
    sqrt_limit = int(math.isqrt(high))
    base_sieve = [True] * (sqrt_limit + 1)
    base_sieve[0] = base_sieve[1] = False
    
    for i in range(2, int(math.isqrt(sqrt_limit)) + 1):
        if base_sieve[i]:
            for j in range(i * i, sqrt_limit + 1, i):
                base_sieve[j] = False
                
    base_primes = [i for i, is_prime in enumerate(base_sieve) if is_prime]

    # Step 2: Create a segmented block to find primes in the target window
    segment_size = high - low + 1
    segment_sieve = [True] * segment_size

    # Step 3: Map the base primes onto the current segment window
    for prime in base_primes:
        # Find the first multiple of 'prime' that is greater than or equal to 'low'
        start_index = (low + prime - 1) // prime * prime
        if start_index < prime * prime:
            start_index = prime * prime
            
        # Mark off all multiples of this prime inside the current segment
        for multiple in range(start_index, high + 1, prime):
            segment_sieve[multiple - low] = False

    # Step 4: Collect and return the final prime numbers
    primes = []
    for i in range(segment_size):
        if segment_sieve[i]:
            primes.append(low + i)
            
    return primes


start_range = 999900000
end_range = 1000000000
discovered_primes = find_primes_in_range(start_range, end_range)

print(f"Segment complete. Found {len(discovered_primes)} primes.")
